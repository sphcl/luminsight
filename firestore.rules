rules_version = '2';

// Regra geral do projeto: nega tudo por padrão. Cada coleção só abre
// exatamente o acesso que precisa, nada além disso.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // createdAt/lastLoginAt precisam ser o carimbo do servidor (serverTimestamp()),
    // nunca uma data que o cliente inventou. O Firestore resolve o sentinel de
    // serverTimestamp() como request.time no momento em que a regra é avaliada,
    // então essa comparação barra quem tentar mandar new Date() na mão.
    function isServerTimestamp(field) {
      return field == request.time;
    }

    // Documento novo só pode nascer com role 'user' e progresso zerado.
    // Ninguém cria a própria conta já como admin ou com módulos "concluídos".
    function isValidUserCreate() {
      let data = request.resource.data;
      return data.role == 'user'
        && data.displayName is string
        && data.email is string
        && (data.photoURL == null || data.photoURL is string)
        && data.onboardingCompleted == false
        && data.completedModules == []
        && data.completedLessons == []
        && data.completedSimulations == []
        && data.totalQuizzesCompleted == 0
        && isServerTimestamp(data.createdAt)
        && isServerTimestamp(data.lastLoginAt);
    }

    function roleIsImmutable() {
      return request.resource.data.role == resource.data.role;
    }

    // Checagem de forma para o documento de progresso (users/{uid}/progress/{moduleId}).
    // LIMITAÇÃO CONHECIDA: isso valida TIPO, não VERACIDADE. Nada aqui garante
    // que o usuário realmente leu a lição, assistiu a simulação ou tirou aquela
    // nota no quiz. Um usuário autenticado pode abrir o console do navegador e
    // chamar markLessonCompleted/saveQuizAttempt manualmente para se autodeclarar
    // "aprovado" sem ter feito nada. Proteção completa exigiria mover a decisão
    // de conclusão para o backend (ex.: Cloud Function validando a submissão do
    // quiz), o que fica fora do escopo desta fase. Aqui só garantimos que o
    // documento tem o formato esperado, para o app não quebrar lendo lixo.
    function isValidProgressShape() {
      let data = request.resource.data;
      return data.lessonsCompleted is list
        && data.quizAttempts is int && data.quizAttempts >= 0
        && (data.quizBestScore == null
            || (data.quizBestScore is number && data.quizBestScore >= 0 && data.quizBestScore <= 100))
        && data.simulationCompleted is bool
        && isServerTimestamp(data.lastUpdatedAt);
    }

    function isValidProgressCreate() {
      let data = request.resource.data;
      return isValidProgressShape()
        && isServerTimestamp(data.startedAt)
        && (data.completedAt == null || isServerTimestamp(data.completedAt));
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUserCreate();
      allow update: if isOwner(userId) && roleIsImmutable();
      allow delete: if false;

      match /progress/{moduleId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidProgressCreate();
        allow update: if isOwner(userId) && isValidProgressShape();
        allow delete: if false;
      }
    }

    // Conteúdo do TCC (trilha, lições): todo usuário autenticado lê,
    // ninguém escreve pelo client, isso só entra via script de seed com o
    // Admin SDK (scripts/seed-modules.ts), que ignora estas regras.
    match /modules/{moduleId} {
      allow read: if isSignedIn();
      allow write: if false;

      match /lessons/{lessonId} {
        allow read: if isSignedIn();
        allow write: if false;
      }
    }

    // Resultado de quiz é criado uma vez e nunca mais muda: impede que o
    // usuário edite a própria nota depois de reprovar
    match /quizResults/{resultId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if false;
    }

    // Catch-all: qualquer coleção que a gente esqueceu de listar acima
    // fica bloqueada, em vez de aberta por omissão
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
